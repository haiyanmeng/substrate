# The fake data plane for control-plane benchmarks, deployed by
# workloads/deploy.sh --fake-data-plane in place of the benchmark WorkerPool.
# fake-atelet takes atelet's place on the nodes labeled
# ate.dev/fake-data-plane=true, and fake-workersync registers fake Workers on
# those nodes. Actors placed on them do not exist. Never deploy this on a
# cluster that serves real actors.

apiVersion: v1
kind: Namespace
metadata:
  name: benchmark-workloads

---

# fake-atelet is dialed by ate-api-server as the node's atelet: it must be in
# ate-system, carry app: atelet, and run as the atelet service account, whose
# pod certificate carries atelet's SPIFFE ID. The ate.dev/fake-atelet label
# keeps its selector disjoint from the real atelet DaemonSet's.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: fake-atelet
  namespace: ate-system
  labels:
    app: atelet
    ate.dev/fake-atelet: "true"
spec:
  selector:
    matchLabels:
      app: atelet
      ate.dev/fake-atelet: "true"
  template:
    metadata:
      labels:
        app: atelet
        ate.dev/fake-atelet: "true"
    spec:
      serviceAccountName: atelet
      # fake-atelet never calls the Kubernetes API: its node name comes from
      # the downward API, and its identity from the projected pod certificate.
      automountServiceAccountToken: false
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
            - matchExpressions:
              - key: ate.dev/fake-data-plane
                operator: In
                values: ["true"]
      # The same toleration as atelet, for node pools reserved for one
      # sandbox class.
      tolerations:
      - key: ate.dev/sandboxClass
        operator: Exists
        effect: NoSchedule
      containers:
      - name: fake-atelet
        image: ko://github.com/agent-substrate/substrate/cmd/benchmarking/fake-atelet
        args:
        - --run=${FAKE_RUN}
        - --workers-per-node=${FAKE_WORKERS_PER_NODE}
        - --worker-capacity-actors=${FAKE_CAPACITY_ACTORS}
        - --worker-capacity-resources=${FAKE_CAPACITY_RESOURCES}
        - --capacity-retry-timeout=${FAKE_CAPACITY_RETRY_TIMEOUT}
        - --delay=${FAKE_DELAY}
        env:
        - name: NODE_NAME
          valueFrom:
            fieldRef:
              fieldPath: spec.nodeName
        # Placeholders go to the backend atelet uses; deploy.sh copies it from
        # the real atelet DaemonSet.
        - name: ATE_STORAGE_BACKEND
          value: "${FAKE_STORAGE_BACKEND}"
        ports:
        - name: grpc
          containerPort: 8085
        # Ready only once capacity is reported for every fake Worker on the
        # node; ate-api-server ignores readiness, so deploy.sh waits on it.
        readinessProbe:
          httpGet:
            path: /readyz
            port: 9090
          periodSeconds: 5
        livenessProbe:
          httpGet:
            path: /healthz
            port: 9090
          initialDelaySeconds: 10
          periodSeconds: 10
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          runAsUser: 65532
          capabilities:
            drop: ["ALL"]
        volumeMounts:
        - name: podidentity
          mountPath: /run/podidentity.podcert.ate.dev
          readOnly: true
        - name: servicedns-ca
          mountPath: /run/servicedns.podcert.ate.dev
          readOnly: true
      volumes:
      - name: podidentity
        projected:
          sources:
          - podCertificate:
              signerName: podidentity.podcert.ate.dev/identity
              keyType: ECDSAP256
              credentialBundlePath: credential-bundle.pem
          - clusterTrustBundle:
              signerName: podidentity.podcert.ate.dev/identity
              labelSelector:
                matchLabels:
                  podcert.ate.dev/canarying: live
              path: trust-bundle.pem
      - name: servicedns-ca
        projected:
          sources:
          - clusterTrustBundle:
              signerName: servicedns.podcert.ate.dev/identity
              labelSelector:
                matchLabels:
                  podcert.ate.dev/canarying: live
              path: trust-bundle.pem

---

apiVersion: v1
kind: ServiceAccount
metadata:
  name: fake-workersync
  namespace: benchmark-workloads

---

# fake-workersync lists the labeled nodes to register Workers on.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: fake-workersync
rules:
- apiGroups: [""]
  resources: ["nodes"]
  verbs: ["list"]

---

# Resolving ate-api-server's k8s:/// target reads its EndpointSlices, through
# the Role atelet and boomer are bound to.
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: fake-workersync-endpointslices
  namespace: ate-system
subjects:
- kind: ServiceAccount
  name: fake-workersync
  namespace: benchmark-workloads
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: atelet-endpointslices

---

apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: fake-workersync
subjects:
- kind: ServiceAccount
  name: fake-workersync
  namespace: benchmark-workloads
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: fake-workersync

---

apiVersion: apps/v1
kind: Deployment
metadata:
  name: fake-workersync
  namespace: benchmark-workloads
  labels:
    app: fake-workersync
spec:
  replicas: 1
  selector:
    matchLabels:
      app: fake-workersync
  template:
    metadata:
      labels:
        app: fake-workersync
    spec:
      serviceAccountName: fake-workersync
      # Shutdown deletes every fake Worker; sized to fit --delete-timeout.
      terminationGracePeriodSeconds: 330
      containers:
      - name: fake-workersync
        image: ko://github.com/agent-substrate/substrate/cmd/benchmarking/fake-workersync
        args:
        - --run=${FAKE_RUN}
        - --workers-per-node=${FAKE_WORKERS_PER_NODE}
        - --node-label=ate.dev/fake-data-plane=true
        - --sandbox-class=${SANDBOX_CLASS}
        - --delete-timeout=5m
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          runAsUser: 65532
          capabilities:
            drop: ["ALL"]
        volumeMounts:
        - name: servicedns-ca
          mountPath: /run/servicedns-ca
          readOnly: true
        - name: podidentity
          mountPath: /run/podidentity.podcert.ate.dev
          readOnly: true
      volumes:
      # The same client identity boomer presents to ate-api-server; see
      # internal/benchmarking/boomer/boomerutil.DialControl.
      - name: servicedns-ca
        projected:
          sources:
          - clusterTrustBundle:
              signerName: servicedns.podcert.ate.dev/identity
              labelSelector:
                matchLabels:
                  podcert.ate.dev/canarying: live
              path: ca.crt
      - name: podidentity
        projected:
          sources:
          - podCertificate:
              signerName: podidentity.podcert.ate.dev/identity
              keyType: ECDSAP256
              credentialBundlePath: credential-bundle.pem

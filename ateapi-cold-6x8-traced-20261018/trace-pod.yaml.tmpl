apiVersion: v1
kind: Pod
metadata: {name: pgio-trace, namespace: kernel-trace}
spec:
  nodeSelector: {kubernetes.io/hostname: NODE}
  hostPID: true
  restartPolicy: Never
  containers:
  - name: bt
    image: quay.io/iovisor/bpftrace:latest
    securityContext: {privileged: true}
    command: ["sh", "-c", "mount -t tracefs tracefs /sys/kernel/tracing 2>/dev/null; exec bpftrace /bt/pgio.bt DEVT SECONDS"]
    volumeMounts:
    - {name: sys, mountPath: /sys}
    - {name: modules, mountPath: /lib/modules, readOnly: true}
    - {name: bt, mountPath: /bt}
  volumes:
  - {name: sys, hostPath: {path: /sys}}
  - {name: modules, hostPath: {path: /lib/modules}}
  - {name: bt, configMap: {name: pgio-bt}}
